{
  "manifest_version": 3,
  "name": "Focus Tracker",
  "version": "1.0",
  "description": "Tracks productive vs distracting sites and shows your focus score.",
  "permissions": ["tabs", "storage", "scripting","activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "host_permissions": [
    "https://api.notion.com/*"
  ],
  "icons": {
    "48": "icons/icon.png"
  }
}